{
  "name": "al-namer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p 3400",
    "build": "next build",
    "start": "next start",
    "vercel-build": "tsx scripts/migrate.mts && tsx scripts/seed-demo.mts && next build",
    "build:local": "node scripts/build-local.mjs",
    "start:local": "node scripts/start-local.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "npm run typecheck && npm run lint && npm run i18n:check",
    "i18n:check": "node scripts/i18n-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.int.config.ts",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run check && npm test && node scripts/require-test-db.mjs && npm run test:int && npm run build:local -- --test-db",
    "db:up": "docker compose up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:seed": "tsx --conditions=react-server scripts/seed.mts",
    "db:seed:demo": "tsx --conditions=react-server scripts/seed-demo.mts",
    "check:env": "node scripts/check-env.mjs",
    "env:init": "node scripts/env-init.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@inngest/middleware-encryption": "^2.0.0",
    "@node-rs/argon2": "2.2.1",
    "@tanstack/react-query": "^5.104.0",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@trpc/tanstack-react-query": "^11.19.0",
    "@upstash/redis": "^1.39.0",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "inngest": "^4.21.1",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "nodemailer": "^10.0.13",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "superjson": "^2.2.6",
    "tailwind-merge": "3.7.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "5.0.3"
  }
}
