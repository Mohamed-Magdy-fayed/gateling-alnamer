{
  "name": "al-namer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "vercel-build": "tsx scripts/migrate.mts && next build",
    "build:local": "node scripts/build-local.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
