# Copy to .env for local development (`npm run env:init`). Never commit real values.
# Runtime mode, required, no default: demo (mocks, demo accounts) or live (real providers only).
APP_MODE=demo
# Postgres (local Docker: `npm run db:up`). Required.
DATABASE_URL=
# Public origin on deployed environments, e.g. https://alnamer.gateling.com
BASE_URL=
# Comma list of hosts allowed to run APP_MODE=demo with VERCEL_ENV=production.
DEMO_HOSTS=
# Demo only: shared password and staff TOTP secret for the seeded demo accounts. Refused in live.
DEMO_ACCOUNTS_PASSWORD=
DEMO_TOTP_SECRET=
# SMTP for password reset emails. Required on Vercel; locally the code is printed when unset.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
# Local Docker only
DB_USER=
DB_PASSWORD=
DB_NAME=
