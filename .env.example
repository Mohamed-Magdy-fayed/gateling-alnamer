# Copy to .env for local development (`npm run env:init`, which also generates the secrets). Never commit real values.
# Runtime mode, required, no default: demo (mocks, demo accounts) or live (real providers only).
APP_MODE=demo
# Postgres for local development (the `db` service in docker-compose.yml). Required.
DATABASE_URL=postgres://alnamer:alnamer@localhost:5432/alnamer
# Public origin; required on deployed environments, e.g. https://alnamer.gateling.com
BASE_URL=http://localhost:3400
# Throwaway test database for `--test-db` (blank = postgres://alnamer_test:alnamer_test@localhost:5433/alnamer_test). Must be a local host.
TEST_DATABASE_URL=
# Comma list of hosts allowed to run APP_MODE=demo with VERCEL_ENV=production.
DEMO_HOSTS=
# Demo only: shared password for the seeded demo accounts. Refused in live.
DEMO_ACCOUNTS_PASSWORD=
# Demo only: TOTP secret for the seeded staff accounts. Refused in live.
DEMO_TOTP_SECRET=
# Payment provider: mock or myfatoorah (demo default mock; live must be myfatoorah).
PAYMENT_PROVIDER=mock
# Video provider: mock, sample or bunny (demo default mock; live must be bunny).
VIDEO_PROVIDER=mock
# Storage driver: local or firebase (demo default local; live must be firebase).
STORAGE_DRIVER=local
# Email transport: smtp or mailpit (mailpit sends to localhost:1025; live must be smtp).
EMAIL_TRANSPORT=mailpit
# Jobs mode: inline, inngest-dev or inngest (live must be inngest).
JOBS_MODE=inline
# Inngest event key: required when JOBS_MODE=inngest and whenever APP_MODE=live.
INNGEST_EVENT_KEY=
# Inngest signing key: required when JOBS_MODE=inngest and whenever APP_MODE=live.
INNGEST_SIGNING_KEY=
# Inngest encryption key: encrypts job payloads at rest in Inngest; required when APP_MODE=live (env:init generates a local one).
INNGEST_ENCRYPTION_KEY=
# Set to 1 to use the local Inngest dev server (docker compose service `inngest`); never on Vercel.
INNGEST_DEV=
# SMTP host: Mailpit locally; the real provider on deployed environments.
SMTP_HOST=localhost
# SMTP port: 1025 is Mailpit.
SMTP_PORT=1025
# SMTP user: blank for Mailpit.
SMTP_USER=
# SMTP password: blank for Mailpit.
SMTP_PASSWORD=
# Sender address of outgoing email.
SMTP_FROM_EMAIL=no-reply@alnamer.local
# Sender display name of outgoing email.
SMTP_FROM_NAME=Al-Namer
# Redis REST proxy URL (the `redis-rest` service in docker-compose.yml).
UPSTASH_REDIS_REST_URL=http://localhost:8079
# Redis REST token; must equal LOCAL_REDIS_TOKEN locally (env:init generates both).
UPSTASH_REDIS_REST_TOKEN=
# Token the local `redis-rest` proxy accepts (generated by env:init).
LOCAL_REDIS_TOKEN=
# Captcha provider: fake or turnstile (demo default fake, which accepts any token; live must be turnstile, which needs both Turnstile keys).
CAPTCHA=fake
# Cloudflare Turnstile site key (public), used when CAPTCHA=turnstile. Cloudflare's always-pass test key is 1x00000000000000000000AA (always-fail: 2x00000000000000000000AB). Real keys are a human step.
TURNSTILE_SITE_KEY=
# Cloudflare Turnstile secret key, used when CAPTCHA=turnstile. Cloudflare's always-pass test secret is 1x0000000000000000000000000000000AA (always-fail: 2x0000000000000000000000000000000AA).
TURNSTILE_SECRET_KEY=
# 32-byte base64 key that encrypts teacher IBANs at rest (generated by env:init).
IBAN_ENCRYPTION_KEY=
# 32-byte base64 key that encrypts staff TOTP secrets at rest (generated by env:init).
TOTP_ENCRYPTION_KEY=
# 32-byte base64 secret that signs the device cookie (generated by env:init).
DEVICE_COOKIE_SECRET=
# Local Docker only: Postgres user of the `db` service.
DB_USER=alnamer
# Local Docker only: Postgres password of the `db` service.
DB_PASSWORD=alnamer
# Local Docker only: Postgres database name of the `db` service.
DB_NAME=alnamer
